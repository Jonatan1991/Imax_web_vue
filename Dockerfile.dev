FROM node:22-alpine

WORKDIR /app

# Copiar manifiestos de dependencias
COPY package*.json ./

# Instalar dependencias del proyecto
RUN npm install

# Copiar el resto del código
COPY . .

# Exponer el puerto de desarrollo de Vite
EXPOSE 3000

# Iniciar Vite en modo desarrollo escuchando en todas las interfaces
CMD ["npm", "run", "dev"]
